# LLM provider: "groq" (default) or "google"
# Note: Gemini free tier is 20 requests/DAY -- not usable for this agent (one report
# is ~10-15 calls). Use groq free tier (per-minute limit, recovers mid-run via
# max_retries) or enable billing on either provider.
LLM_PROVIDER=groq

# If LLM_PROVIDER=groq -- key at console.groq.com, models via /openai/v1/models
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=openai/gpt-oss-20b

# If LLM_PROVIDER=google -- key at aistudio.google.com/apikey (needs billing enabled
# to be practical; free tier daily quota is too low)
GOOGLE_API_KEY=your_google_ai_studio_key
GOOGLE_MODEL=gemini-3.6-flash

# Rate-limit relief for tight free tiers. A report fans out 1 LLM call per plan task
# in parallel. Lower the task count and stagger the calls so they don't all hit the
# provider at once. Suggested for Groq free tier: MAX_PLAN_TASKS=4, WORKER_STAGGER_SECONDS=15
MAX_PLAN_TASKS=4
WORKER_STAGGER_SECONDS=15
# Live token-by-token streaming in the UI. Off by default (flaky, and expensive to
# retry when it fails). Set to 1 only on a provider/tier that can spare the retries.
STREAM_TOKENS=0

# Optional: web research
TAVILY_API_KEY=your_tavily_api_key

# Optional: image generation
HF_TOKEN=your_huggingface_token

# Optional: access control (unset = open). Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
APP_ACCESS_KEY=
INGESTION_API_KEY=

# Optional: LangSmith tracing (key at smith.langchain.com -> Settings -> API Keys).
# No code change needed -- the langchain/langsmith SDK reads these directly.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=your_langsmith_api_key
LANGSMITH_PROJECT=investment-dd-agent
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# Checkpoint deserialization hardening -- keep on
LANGGRAPH_STRICT_MSGPACK=1
